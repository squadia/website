        "jsonBody": "={\n  \"q\": \"\\\"directeur communication\\\" OR \\\"directrice communication\\\" UDAF \\\"{{ $('Traiter un par un').item.json.fields.Ville }}\\\" site:linkedin.com\",\n  \"hl\": \"fr\",\n  \"gl\": \"fr\",\n  \"num\": 5\n}",
