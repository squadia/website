    {
      "parameters": {
        "jsCode": "// Récupération des données source\nconst udafRecord = $('Traiter un par un').item.json;\nconst serperResults = $('Recherche Serper').item.json;\nconst linkedinResults = $('Recherche LinkedIn').item.json;\n\nconst udafName = udafRecord.fields.UDAF || '';\nconst ville = udafRecord.fields.Ville || '';\nconst recordId = udafRecord.id;\n\n// --- Extraction nom/prénom depuis les résultats Serper ---\nlet nom = '';\nlet prenom = '';\nlet jobTitle = '';\nlet linkedinUrl = '';\n\n// Regex pour détecter les noms propres\nconst nameRegex = /([A-ZÉÈÊËÀÂÎÏÔÙÛÜ][a-zéèêëàâîïôùûü]+(?:-[A-ZÉÈÊËÀÂÎÏÔÙÛÜ][a-zéèêëàâîïôùûü]+)?)\\s+([A-ZÉÈÊËÀÂÎÏÔÙÛÜ][A-ZÉÈÊËÀÂÎÏÔÙÛÜ]+(?:-[A-ZÉÈÊËÀÂÎÏÔÙÛÜ][A-ZÉÈÊËÀÂÎÏÔÙÛÜ]+)?)/;\nconst titleRegex = /directeur|directrice|responsable.*communication/i;\n\n// Parcourir les résultats organiques\nconst organicResults = serperResults.organic || [];\nfor (const result of organicResults) {\n  const text = (result.title || '') + ' ' + (result.snippet || '');\n  \n  if (titleRegex.test(text)) {\n    const nameMatch = text.match(nameRegex);\n    if (nameMatch) {\n      // Heuristique : prénom = 1er mot capitalisé (style titre), nom = tout majuscules\n      const part1 = nameMatch[1];\n      const part2 = nameMatch[2];\n      if (part2 === part2.toUpperCase()) {\n        prenom = part1;\n        nom = part2;\n      } else if (part1 === part1.toUpperCase()) {\n        nom = part1;\n        prenom = part2;\n      } else {\n        prenom = part1;\n        nom = part2;\n      }\n      // Extraire le titre\n      const titleMatch = text.match(/(directeur|directrice|responsable\\s+(?:de\\s+la\\s+)?communication)[\\s,–-]*/i);\n      if (titleMatch) {\n        jobTitle = titleMatch[0].trim();\n      }\n      break;\n    }\n  }\n}\n\n// Chercher LinkedIn dans les résultats LinkedIn\nconst linkedinOrganic = linkedinResults.organic || [];\nfor (const result of linkedinOrganic) {\n  if (result.link && result.link.includes('linkedin.com/in/')) {\n    linkedinUrl = result.link;\n    // Si on n'a pas encore de nom, tenter d'extraire du titre LinkedIn\n    if (!nom && result.title) {\n      const liTitle = result.title.replace(/\\s*[-–|].*$/, '').trim();\n      const parts = liTitle.split(' ');\n      if (parts.length >= 2) {\n        prenom = parts[0];\n        nom = parts.slice(1).join(' ');\n      }\n    }\n    if (!jobTitle && result.snippet) {\n      const titleMatch = result.snippet.match(/(directeur|directrice|responsable\\s+(?:de\\s+la\\s+)?communication)[^,\\n]*/i);\n      if (titleMatch) jobTitle = titleMatch[0].trim();\n    }\n    break;\n  }\n}\n\n// Résultat structuré\nreturn [{\n  json: {\n    recordId,\n    udaf: udafName,\n    ville,\n    nom,\n    prenom,\n    jobTitle,\n    linkedinUrl,\n    rawSnippets: organicResults.slice(0, 3).map(r => r.title + ' — ' + r.snippet)\n  }\n}];\n"
      },
