      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.heygen.com/v3/videos",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: 'studio', title: 'Merci ' + ($json.firstName || ''), resolution: '720p', aspect_ratio: '16:9', scenes: [{ type: 'avatar_video', input: { type: 'avatar', avatar_id: $json.scene1_look, script: $json.scene1_texte, voice_id: $json.voice_id, expressiveness: $json.expressivite, voice_settings: { speed: $json.voix_vitesse, engine_settings: { engine_type: 'elevenlabs', model: $json.voix_modele, stability: $json.voix_stabilite, similarity_boost: $json.voix_similarite, style: $json.voix_style } } } }, { type: 'avatar_video', input: { type: 'avatar', avatar_id: $json.scene2_look, script: $json.scene2_texte, voice_id: $json.voice_id, expressiveness: $json.expressivite, voice_settings: { speed: $json.voix_vitesse, engine_settings: { engine_type: 'elevenlabs', model: $json.voix_modele, stability: $json.voix_stabilite, similarity_boost: $json.voix_similarite, style: $json.voix_style } } } }, { type: 'avatar_video', input: { type: 'avatar', avatar_id: $json.scene3_look, script: $json.scene3_texte, voice_id: $json.voice_id, expressiveness: $json.expressivite, voice_settings: { speed: $json.voix_vitesse, engine_settings: { engine_type: 'elevenlabs', model: $json.voix_modele, stability: $json.voix_stabilite, similarity_boost: $json.voix_similarite, style: $json.voix_style } } } }] }) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "name": "HeyGen : générer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "HeyGen API"
        }
      },
      "onError": "continueErrorOutput"
    },
