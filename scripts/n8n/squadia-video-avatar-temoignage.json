{
  "name": "Squadia - Vidéo avatar Témoignage (API v3)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "temoignage-avatar",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "temoignage-avatar"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://veofbxujodjoqeynzsbj.supabase.co/functions/v1/testimonials-admin",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'avatar_job', id: $('Webhook').item.json.body.id, token: $('Webhook').item.json.body.token }) }}"
      },
      "name": "Récupérer le job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "texte",
              "name": "texte",
              "value": "=Salut {{ $json.firstName }} ! Merci… vraiment, merci pour ton témoignage vidéo. {{ $json.note }}",
              "type": "string"
            },
            {
              "id": "avatar_id",
              "name": "avatar_id",
              "value": "78970c160bde4b38b7e493c41691c1a8",
              "type": "string"
            },
            {
              "id": "voice_id",
              "name": "voice_id",
              "value": "c08723c5f7ba4c24a0ca086848f1073d",
              "type": "string"
            },
            {
              "id": "vitesse",
              "name": "vitesse",
              "value": 1,
              "type": "number"
            },
            {
              "id": "modele_voix",
              "name": "modele_voix",
              "value": "eleven_multilingual_v2",
              "type": "string"
            },
            {
              "id": "firstName",
              "name": "firstName",
              "value": "={{ $json.firstName }}",
              "type": "string"
            },
            {
              "id": "email",
              "name": "email",
              "value": "={{ $json.email }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "name": "Réglages vidéo",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        300
      ],
      "notes": "Modifiez ici le texte lu par l'avatar, l'avatar, la voix et la vitesse (0.5 à 1.5).",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.heygen.com/v3/videos",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: 'avatar', title: 'Merci ' + ($json.firstName || ''), avatar_id: $json.avatar_id, voice_id: $json.voice_id, script: $json.texte, resolution: '720p', aspect_ratio: '16:9', voice_settings: { speed: $json.vitesse, engine_settings: { engine_type: 'elevenlabs', model: $json.modele_voix } } }) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "name": "HeyGen : générer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "HeyGen API"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "amount": 60
      },
      "name": "Attendre 60 s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        880,
        300
      ],
      "webhookId": "temoignage-avatar-wait"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.heygen.com/v3/videos/{{ $('HeyGen : générer').item.json.data.video_id }}",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "name": "HeyGen : statut",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "HeyGen API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.data?.status }}",
                    "rightValue": "completed",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Terminée"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "or",
                "conditions": [
                  {
                    "leftValue": "={{ $json.data?.status }}",
                    "rightValue": "failed",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  },
                  {
                    "leftValue": "={{ $runIndex }}",
                    "rightValue": 45,
                    "operator": {
                      "type": "number",
                      "operation": "gte"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Échec"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "En cours"
        }
      },
      "name": "Statut ?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1320,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://veofbxujodjoqeynzsbj.supabase.co/functions/v1/testimonials-admin",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'avatar_done', id: $('Webhook').item.json.body.id, token: $('Webhook').item.json.body.token, video_url: $json.data.video_url, thumbnail_url: $json.data.thumbnail_url }) }}"
      },
      "name": "Stocker la vidéo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        160
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "={{ $json.firstName }}, un petit message vidéo pour toi",
        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,sans-serif;font-size:15px;line-height:1.6;color:#111;max-width:560px\">\n<p>Salut {{ $json.firstName }},</p>\n<p>J'ai enregistré un petit message vidéo rien que pour toi, suite à ton témoignage.</p>\n{{ $json.thumbnailUrl ? '<p><a href=\"' + $json.watchUrl + '\"><img src=\"' + $json.thumbnailUrl + '\" alt=\"Regarder la vidéo\" width=\"520\" style=\"width:100%;max-width:520px;border-radius:12px;display:block\"></a></p>' : '' }}\n<p><a href=\"{{ $json.watchUrl }}\" style=\"display:inline-block;background:#44CCFF;color:#050510;font-weight:bold;text-decoration:none;padding:12px 22px;border-radius:30px\">▶ Regarder la vidéo</a></p>\n<p>À très vite,<br>Jérôme</p>\n</div>",
        "options": {
          "appendAttribution": false,
          "senderName": "Jérôme de Squadia"
        }
      },
      "name": "Envoyer l'email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1780,
        160
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "CNF4MVqIz8zVRNZ1",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://veofbxujodjoqeynzsbj.supabase.co/functions/v1/testimonials-admin",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'avatar_failed', id: $('Webhook').item.json.body.id, token: $('Webhook').item.json.body.token, error: 'HeyGen : ' + ($json.data?.failure_message || $json.error?.message || $json.message || (typeof $json.error === 'string' ? $json.error : '') || 'échec ou délai dépassé') }) }}"
      },
      "name": "Signaler l'échec",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        460
      ]
    }
  ],
